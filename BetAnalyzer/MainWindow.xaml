<Window x:Class="BetAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BetAnalyzer"
        Width="1420"
        Height="800"
        MinWidth="1050"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FA">

    <Window.Resources>

        <BooleanToVisibilityConverter
            x:Key="BoolToVisibility" />

        <Style x:Key="Card"
               TargetType="Border">

            <Setter Property="Background"
                    Value="White" />

            <Setter Property="CornerRadius"
                    Value="12" />

            <Setter Property="Padding"
                    Value="18" />

            <Setter Property="Margin"
                    Value="0,0,0,16" />

            <Setter Property="BorderBrush"
                    Value="#E1E7EF" />

            <Setter Property="BorderThickness"
                    Value="1" />
        </Style>

        <Style TargetType="Button">

            <Setter Property="Padding"
                    Value="14,8" />

            <Setter Property="Margin"
                    Value="4" />

            <Setter Property="Cursor"
                    Value="Hand" />

            <Setter Property="MinHeight"
                    Value="34" />

            <Style.Triggers>

                <Trigger Property="IsEnabled"
                         Value="False">

                    <Setter Property="Opacity"
                            Value="0.45" />

                    <Setter Property="Cursor"
                            Value="Arrow" />

                </Trigger>

            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">

            <Setter Property="BorderBrush"
                    Value="#CBD5E1" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="Background"
                    Value="White" />

            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
        </Style>

        <Style TargetType="ComboBox">

            <Setter Property="BorderBrush"
                    Value="#CBD5E1" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="Background"
                    Value="White" />

            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
        </Style>

        <Style TargetType="DataGrid">

            <Setter Property="Background"
                    Value="White" />

            <Setter Property="BorderBrush"
                    Value="#DCE3EC" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="GridLinesVisibility"
                    Value="Horizontal" />

            <Setter Property="HorizontalGridLinesBrush"
                    Value="#E8EDF3" />

            <Setter Property="VerticalGridLinesBrush"
                    Value="Transparent" />

            <Setter Property="CanUserAddRows"
                    Value="False" />

            <Setter Property="CanUserDeleteRows"
                    Value="False" />

            <Setter Property="IsReadOnly"
                    Value="True" />

            <Setter Property="AutoGenerateColumns"
                    Value="False" />

            <Setter Property="EnableRowVirtualization"
                    Value="True" />

            <Setter Property="EnableColumnVirtualization"
                    Value="True" />

            <Setter Property="AlternatingRowBackground"
                    Value="#F8FAFC" />

            <Setter Property="AlternationCount"
                    Value="2" />

            <Setter Property="RowHeight"
                    Value="34" />

            <Setter Property="SelectionMode"
                    Value="Single" />

            <Setter Property="SelectionUnit"
                    Value="FullRow" />

            <Setter Property="HorizontalScrollBarVisibility"
                    Value="Auto" />

            <Setter Property="VerticalScrollBarVisibility"
                    Value="Auto" />

            <Setter Property="RowHeaderWidth"
                    Value="0" />
        </Style>

        <Style TargetType="DataGridCell">

            <Setter Property="BorderThickness"
                    Value="0" />

            <Setter Property="Padding"
                    Value="8,4" />

            <Setter Property="VerticalContentAlignment"
                    Value="Center" />

            <Setter Property="TextBlock.TextTrimming"
                    Value="CharacterEllipsis" />
        </Style>

        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#172B4D" />

            <Setter Property="Foreground"
                    Value="White" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="Padding"
                    Value="10,8" />

            <Setter Property="HorizontalContentAlignment"
                    Value="Center" />

            <Setter Property="BorderBrush"
                    Value="#2C4267" />

            <Setter Property="BorderThickness"
                    Value="0,0,1,0" />
        </Style>

    </Window.Resources>

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Nagłówek -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <TextBlock Text="BetAnalyzer"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#172B4D" />

            <TextBlock Text="Scraping kursów Superbet i statystyk Flashscore"
                       Foreground="#667085"
                       Margin="0,4,0,0" />

        </StackPanel>

        <!-- Parametry -->

        <Border Grid.Row="1"
                Style="{StaticResource Card}">

            <WrapPanel VerticalAlignment="Center">

                <StackPanel Margin="0,0,18,0">

                    <TextBlock Text="Minimalny kurs"
                               FontWeight="SemiBold" />

                    <TextBox Width="110"
                             Height="32"
                             Padding="8,4"
                             Text="{Binding MinimumOddText,
                                            UpdateSourceTrigger=PropertyChanged}" />

                </StackPanel>

                <StackPanel Margin="0,0,18,0">

                    <TextBlock Text="Mecze historii"
                               FontWeight="SemiBold" />

                    <TextBox Width="90"
                             Height="32"
                             Padding="8,4"
                             Text="{Binding HistoryCount,
                                            UpdateSourceTrigger=PropertyChanged}" />

                </StackPanel>

                <StackPanel Margin="0,0,18,0">

                    <TextBlock Text="Próg BTTS"
                               FontWeight="SemiBold" />

                    <TextBox Width="90"
                             Height="32"
                             Padding="8,4"
                             Text="{Binding MinimumGoalMatches,
                                            UpdateSourceTrigger=PropertyChanged}" />

                </StackPanel>

                <StackPanel Margin="0,0,18,0">

                    <TextBlock Text="Zakres historii"
                               FontWeight="SemiBold" />

                    <ComboBox Width="140"
                              Height="32"
                              ItemsSource="{Binding HistoryScopes}"
                              SelectedItem="{Binding SelectedHistoryScope}" />

                </StackPanel>

                <StackPanel VerticalAlignment="Bottom"
                            Orientation="Horizontal">

                    <Button Content="Uruchom analizę"
                            Command="{Binding StartAnalysisCommand}"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            MinWidth="150"
                            ToolTip="Pobierz kursy i uruchom analizę meczów" />

                    <Button Content="Anuluj"
                            Command="{Binding CancelAnalysisCommand}"
                            Background="#E5484D"
                            Foreground="White"
                            BorderThickness="0"
                            MinWidth="90"
                            ToolTip="Anuluj działającą analizę" />

                    <Button Content="Eksportuj Excel"
                            Command="{Binding ExportToExcelCommand}"
                            Background="#16A34A"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            MinWidth="140"
                            ToolTip="Zapisz aktualne wyniki do pliku Excel" />

                </StackPanel>

            </WrapPanel>

        </Border>

        <!-- Wyniki -->

        <Border Grid.Row="2"
                Style="{StaticResource Card}"
                Padding="0">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0"
                           Margin="18,16,18,10">

                    <ProgressBar DockPanel.Dock="Right"
                                 Width="170"
                                 Height="8"
                                 Margin="12,7,0,0"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsBusy,
                                                      Converter={StaticResource BoolToVisibility}}" />

                    <StackPanel>

                        <TextBlock Text="Wyniki analizy"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#172B4D" />

                        <TextBlock Text="{Binding Results.Count,
                                                  StringFormat=Wyników: {0}}"
                                   FontSize="12"
                                   Foreground="#667085"
                                   Margin="0,2,0,0" />

                    </StackPanel>

                </DockPanel>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Results}"
                          Margin="18,0,18,18">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Mecz"
                                            Binding="{Binding Match}"
                                            Width="220" />

                        <DataGridTextColumn Header="Typ zdarzenia"
                                            Binding="{Binding EventType}"
                                            Width="260" />

                        <DataGridTextColumn Header="Kurs"
                                            Binding="{Binding Odd,
                                                              StringFormat={}{0:0.00}}"
                                            Width="70" />

                        <DataGridTextColumn Header="Szansa"
                                            Binding="{Binding Probability,
                                                              StringFormat={}{0:0.0}%}"
                                            Width="80" />

                        <DataGridTextColumn Header="Edge"
                                            Binding="{Binding Edge,
                                                              StringFormat={}{0:+0.0%;-0.0%;0.0%}}"
                                            Width="80">

                            <DataGridTextColumn.ElementStyle>

                                <Style TargetType="TextBlock">

                                    <Setter Property="HorizontalAlignment"
                                            Value="Center" />

                                    <Setter Property="ToolTip"
                                            Value="Przewaga modelu nad prawdopodobieństwem wynikającym z kursu." />

                                </Style>

                            </DataGridTextColumn.ElementStyle>

                        </DataGridTextColumn>

                        <DataGridTextColumn Header="EV"
                                            Binding="{Binding ExpectedValue,
                                                              StringFormat={}{0:+0.0%;-0.0%;0.0%}}"
                                            Width="75">

                            <DataGridTextColumn.ElementStyle>

                                <Style TargetType="TextBlock">

                                    <Setter Property="HorizontalAlignment"
                                            Value="Center" />

                                    <Setter Property="ToolTip"
                                            Value="Wartość oczekiwana dla stawki jednej jednostki." />

                                </Style>

                            </DataGridTextColumn.ElementStyle>

                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Pewność"
                                            Binding="{Binding ConfidenceLevel}"
                                            Width="120" />

                        <DataGridTextColumn Header="5 meczów"
                                            Binding="{Binding FiveMatchesCriterion}"
                                            Width="150" />

                        <DataGridTextColumn Header="Rekomendacja"
                                            Binding="{Binding Recommendation}"
                                            Width="120" />

                        <DataGridTextColumn Header="Szczegóły"
                                            Binding="{Binding Details}"
                                            Width="*" />

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>

        <!-- Status -->

        <Border Grid.Row="3"
                Background="#172B4D"
                CornerRadius="8"
                Padding="12">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="STATUS"
                           Foreground="#AFC7F5"
                           FontWeight="Bold"
                           FontSize="12"
                           VerticalAlignment="Top"
                           Margin="0,1,14,0" />

                <TextBox Grid.Column="1"
                         Text="{Binding StatusMessage}"
                         Foreground="White"
                         Background="Transparent"
                         BorderThickness="0"
                         IsReadOnly="True"
                         IsReadOnlyCaretVisible="True"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         HorizontalScrollBarVisibility="Disabled"
                         VerticalScrollBarVisibility="Auto"
                         Padding="0"
                         FontFamily="Consolas"
                         FontSize="13"
                         Focusable="True" />

            </Grid>

        </Border>

    </Grid>

</Window>